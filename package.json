{
  "name": "11ty-landing-page",
  "version": "0.0.1",
  "description": "A simple landing page built with 11ty and Tailwind CSS",
  "type": "module",
  "scripts": {
    "clean": "rm -rf public; rm -rf .cache",
    "serve": "ELEVENTY_ENV=dev eleventy --serve",
    "deploy": "eleventy",
    "deploy-pgs": "ELEVENTY_ENV=pages eleventy"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "author": "ttntm",
  "license": "MIT",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.5",
    "@11ty/eleventy-fetch": "^5.1.2",
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "autoprefixer": "^10.4.27",
    "cssnano": "^7.1.4",
    "html-minifier": "^4.0.0",
    "postcss": "^8.5.8",
    "postcss-import": "^16.1.1",
    "pug": "^3.0.4",
    "tailwindcss": "^3",
    "ws": "^8.20.0"
  }
}
